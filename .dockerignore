# --- vcs / tooling ---
.git
.gitignore
.github
.vscode
.idea
.claude

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# --- big stuff that must never enter the build context ---
data/
datasets/
runs/
wandb/
notebooks/
bench/
reports/
scripts/

# training artifacts. The torch backend now decodes through ultralytics, so the
# served registry needs one .pt too -- keep v3 (the served nano), drop the rest.
models/*.pt
!models/football_detection_v3.pt
models/*.part
models/*.prep.onnx
models/*.engine
models/football_detection_v1*.onnx
models/football_detection_v2*.onnx
models/*_fp16.onnx
!models/.gitkeep

# --- media / scratch ---
*.mp4
*.avi
*.mov
*.zip
*.tar
*.tar.gz
*.log
.DS_Store

# --- docs ---
README.md
*.md
!requirements.txt
Dockerfile
.dockerignore
