# --- vcs / tooling ---
.git
.gitignore
.github
.vscode
.idea
.claude

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# --- big stuff that must never enter the build context ---
data/
datasets/
runs/
wandb/
notebooks/
bench/
reports/
scripts/

# training artifacts. The default registry is the four ONNX presets; keep only v3's .pt, which a
# MODELS=torch=models/football_detection_v3.pt override can use, and drop the rest.
models/*.pt
!models/football_detection_v3.pt
models/*.part
models/*.prep.onnx
models/*.engine
# v1 and v2 only: "v1*" would also match v10..v19 (v13 is a served preset), so name the suffixes
models/football_detection_v1.onnx
models/football_detection_v1_*.onnx
models/football_detection_v2.onnx
models/football_detection_v2_*.onnx
models/*_fp16.onnx
!models/.gitkeep

# --- media / scratch ---
*.mp4
*.avi
*.mov
*.zip
*.tar
*.tar.gz
*.log
.DS_Store

# --- docs ---
README.md
*.md
!requirements.txt
Dockerfile
.dockerignore
