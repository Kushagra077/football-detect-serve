# claude
.claude

# personal progress tracking, not a deliverable
PROGRESS.md
A1-detection-serving-build-spec.md
review.md
design_decision.md

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# lockfile only matters for local `uv sync`; requirements.txt is the real,
# deliberately-unpinned install source for Docker/HF. Also carries stale
# transitive-dependency names we don't want tracked.
uv.lock

# --- data & training artifacts ---
data/
dataset/
soccernet_data/
runs/
wandb/
*.zip
*.tar.gz

# --- models: gitignored except the placeholder, the download script, and the
# currently-served v3 weights (shipped so CI can run scripts/benchmark.py on
# an x86 runner without a training step) ---
models/*
!models/.gitkeep
!models/download_weights.py
!models/football_detection_v3.pt
!models/football_detection_v3.onnx
!models/football_detection_v3_int8.onnx

# --- reports: keep the committed summaries, drop the noise ---
# reports/figures/*
!reports/figures/.gitkeep
reports/train_metrics.json
# eval_map.py rewrites this scratch copy on every run alongside the named report
reports/accuracy.json

# dataset.json and the 8 canonical accuracy runs back the numbers in README -
# committed so the repo's own claims are checkable. Any OTHER accuracy.*.json
# (stray/duplicate eval runs) stays ignored by the blanket rule below.
!reports/dataset.json
reports/accuracy.*.json
!reports/accuracy.baseline.json
!reports/accuracy.torch.v1.json
!reports/accuracy.torch.v2.json
!reports/accuracy.onnx.v1.fp32.json
!reports/accuracy.onnx.v2.fp32.json
!reports/accuracy.onnx.v1.int8.json
!reports/accuracy.onnx.v2.int8.json
!reports/accuracy.onnx.v1.fp16.json
!reports/accuracy.torch.v1.test.json
!reports/accuracy.torch.v2.test.json
!reports/accuracy.torch.v3.json
!reports/accuracy.torch.v3.test.json
!reports/accuracy.onnx.v3.fp32.json
!reports/accuracy.onnx.v3.int8.json

